# Auto detect text files and perform line-ending normalization
* text=auto

# Code, markup and metadata
*.lua text eol=lf
*.toc text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.xml text eol=lf

# Binary media assets (guarantee Git never alters binary bytes)
*.png binary
*.tga binary
*.blp binary
*.ogg binary
*.mp3 binary
*.wav binary

# CurseForge / BigWigs packager / Git Archive export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.pkgmeta export-ignore
/README.md export-ignore
/.github export-ignore
/.vscode export-ignore
/.idea export-ignore
/.agents export-ignore
/.gemini export-ignore
/package.ps1 export-ignore
